# Kiri — environment variables
# Copy to backend/.env for local development. Every value is optional locally.

# Where Kiri keeps its database, signing key, uploads and reference files.
# KIRI_DATA_DIR=./data

# ── Hosted test build only ──
# KIRI_SERVER_MODE=true
# KIRI_VERIFICATION_FILES=      # optional: "name.txt:token" files served outside the gate (domain verification)
# KIRI_ACCESS_PASSWORD=          # required in server mode, 12+ characters
# KIRI_STATIC_DIR=../frontend/dist

# ── Optional ──
# INVITE_CODE=                   # if set, creating an account needs this code
# CORS_ORIGINS=http://localhost:5173   # only when the frontend runs on another origin
# DATABASE_URL=                  # default: SQLite in the data folder
# REDIS_URL=                     # default: in-process cache
# BIOGRID_API_KEY=
# GEMINI_API_KEY=                # optional AI literature mining (needs the "ai" extra)
