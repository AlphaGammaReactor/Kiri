# Kiri — Environment Variables
# Copy to .env and fill in values

# Database (auto-configured by docker-compose, override for external DB)
DATABASE_URL=postgresql+asyncpg://kiri:kiri@postgres:5432/kiri

# Redis (auto-configured by docker-compose)
REDIS_URL=redis://redis:6379/0

# External API Keys (optional)
BIOGRID_API_KEY=
GEMINI_API_KEY=
